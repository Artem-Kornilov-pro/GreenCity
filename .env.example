# Скопируйте в .env и подставьте свои значения. Сам .env в git не коммитится.

# LLM -- Yandex AI Studio (core/yandex_ai.py), один ключ и каталог на обе
# задачи: правку плана текстом (ИИ-ассистент) и текст-обоснование решений
# GreenPlan. Ключ API и каталог -- в консоли Yandex Cloud (AI Studio).
LLM_PROVIDER=yandex
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
# ИИ-ассистент: строгий JSON по длинной инструкции, без рассуждений.
YANDEX_CLOUD_MODEL=qwen3-235b-a22b-fp8/latest
# Текст-обоснование GreenPlan: связный русский текст пояснительной записки.
YANDEX_CLOUD_REPORT_MODEL=yandexgpt-5.1/latest

# Запасной провайдер ИИ-ассистента -- Google Gemini (LLM_PROVIDER=gemini;
# ключ -- из Google AI Studio, https://ai.google.dev/gemini-api/docs).
# Текст-обоснование GreenPlan всегда идёт через Yandex.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Аккаунты и проекты (backend/accounts/auth.py, backend/storage/db.py). Без JWT_SECRET
# используется встроенная дев-заглушка (см. auth.py) -- регистрация и вход
# работают, но токены подделываемы любым, кто прочитает исходники; для
# реального многопользовательского запуска задайте свою случайную строку.
JWT_SECRET=

# MONGO_URI и REDIS_URL нужны, только если запускаете backend НЕ через
# docker compose (там оба адреса уже заданы в docker-compose.yml) -- например,
# при локальном запуске uvicorn со своими локальными mongod/redis-server.
# MONGO_URI=mongodb://localhost:27017
# REDIS_URL=redis://localhost:6379/0

# Уровень логов (backend/monitoring/logging_config.py) -- по умолчанию INFO. DEBUG при
# отладке, WARNING в проде, чтобы не копить лишний объём в Loki.
# LOG_LEVEL=INFO

# Сеть и Swagger (backend/main.py). Бэкенд работает за прокси фронтенда
# (vite в дев-режиме, nginx в продакшене), браузер обращается к API с того же
# адреса, поэтому CORS выключен. Разрешить другие адреса (например, фронтенд
# на отдельном домене) -- списком через запятую.
# CORS_ALLOW_ORIGINS=https://greencity.example.ru
# Swagger (/docs): 1 -- открыт (дев-режим), 0 -- выключен (продакшен).
# API_DOCS=1
# Чьим X-Forwarded-For верить (IP клиента для лимитов частоты). * -- любому,
# пока бэкенд доступен только из сети контейнеров; при прямой публикации
# бэкенда -- адрес своего прокси или 127.0.0.1.
# FORWARDED_ALLOW_IPS=*

# Защита тяжёлых эндпоинтов (backend/api/protection.py, backend/core/concurrency.py).
# RATE_LIMIT_MULTIPLIER=1   # множитель лимитов частоты с одного IP, 0 -- выключить
# MAX_UPLOAD_MB=200         # загрузка DXF и папки DWG
# MAX_BODY_MB=64            # остальные запросы (сцена в JSON)
# MAX_DWG_FILES=60          # файлов .dwg за одну загрузку
# HEAVY_CONCURRENCY=1       # тяжёлых расчётов одновременно на процесс uvicorn
# HEAVY_QUEUE_MAX=8         # запросов в очереди расчётов, сверх -- 503
# HEAVY_WAIT_S=120          # сколько ждать очереди, дольше -- 503

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="GreenCityDefinitions" targetNamespace="https://github.com/Artem-Kornilov-pro/GreenCity" exporter="tools/docs/build_bpmn.py" exporterVersion="1.0">
<bpmn:collaboration id="Collaboration"><bpmn:participant id="Pool" name="GreenCity: от входного DXF до выходного DXF и файла объяснений" processRef="Process"/></bpmn:collaboration>
<bpmn:process id="Process" name="От входного DXF до выходного DXF" isExecutable="false">
<bpmn:laneSet id="LaneSet"><bpmn:lane id="Lane_User" name="Пользователь (редактор)"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Upload</bpmn:flowNodeRef><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Check</bpmn:flowNodeRef><bpmn:flowNodeRef>TextEdit</bpmn:flowNodeRef><bpmn:flowNodeRef>EditJoin</bpmn:flowNodeRef><bpmn:flowNodeRef>Fork</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Backend" name="Бэкенд GreenCity"><bpmn:flowNodeRef>Format</bpmn:flowNodeRef><bpmn:flowNodeRef>Dwg</bpmn:flowNodeRef><bpmn:flowNodeRef>FormatJoin</bpmn:flowNodeRef><bpmn:flowNodeRef>Store</bpmn:flowNodeRef><bpmn:flowNodeRef>Parse</bpmn:flowNodeRef><bpmn:flowNodeRef>GreenPlan</bpmn:flowNodeRef><bpmn:flowNodeRef>Apply</bpmn:flowNodeRef><bpmn:flowNodeRef>Export</bpmn:flowNodeRef><bpmn:flowNodeRef>Explain</bpmn:flowNodeRef><bpmn:flowNodeRef>Note</bpmn:flowNodeRef><bpmn:flowNodeRef>Join</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_LLM" name="Yandex AI Studio (LLM)"><bpmn:flowNodeRef>Assistant</bpmn:flowNodeRef><bpmn:flowNodeRef>Report</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start" name="Чертёж участка: DXF или папка DWG"><bpmn:outgoing>Main_Flow_0</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="Upload" name="Загрузить чертёж в редактор"><bpmn:incoming>Main_Flow_0</bpmn:incoming><bpmn:outgoing>Main_Flow_1</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="Format" name="Формат?"><bpmn:incoming>Main_Flow_1</bpmn:incoming><bpmn:outgoing>Main_Flow_2</bpmn:outgoing><bpmn:outgoing>Main_Flow_3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="Dwg" name="DWG → DXF (LibreDWG), склейка пачки в один документ"><bpmn:incoming>Main_Flow_2</bpmn:incoming><bpmn:outgoing>Main_Flow_4</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="FormatJoin" name=""><bpmn:incoming>Main_Flow_3</bpmn:incoming><bpmn:incoming>Main_Flow_4</bpmn:incoming><bpmn:outgoing>Main_Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="Store" name="Сохранить исходный чертёж (id = sha256)"><bpmn:incoming>Main_Flow_5</bpmn:incoming><bpmn:outgoing>Main_Flow_6</bpmn:outgoing><bpmn:dataOutputAssociation id="Main_Assoc_0"><bpmn:targetRef>Sources</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
<bpmn:dataStoreReference id="Sources" name="Хранилище исходных чертежей"/>
<bpmn:task id="Parse" name="Разбор слоёв: граница, зоны ограничений, здания, объекты → сцена"><bpmn:incoming>Main_Flow_6</bpmn:incoming><bpmn:outgoing>Main_Flow_7</bpmn:outgoing></bpmn:task>
<bpmn:task id="Review" name="3D-сцена, зоны ограничений; параметры GreenPlan"><bpmn:incoming>Main_Flow_7</bpmn:incoming><bpmn:outgoing>Main_Flow_8</bpmn:outgoing></bpmn:task>
<bpmn:subProcess id="GreenPlan" name="GreenPlan: озеленение по проектам-аналогам"><bpmn:incoming>Main_Flow_8</bpmn:incoming><bpmn:outgoing>Main_Flow_9</bpmn:outgoing><bpmn:property id="GreenPlan_In1" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="Main_Assoc_1"><bpmn:sourceRef>Corpus</bpmn:sourceRef><bpmn:targetRef>GreenPlan_In1</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:startEvent id="GP_Start" name="Сцена участка и параметры GreenPlan"><bpmn:outgoing>Sub_Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:task id="GP_Clean" name="Убрать прошлый результат GreenPlan"><bpmn:incoming>Sub_Flow_0</bpmn:incoming><bpmn:outgoing>Sub_Flow_1</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="GP_Impr" name="Благоустройство?"><bpmn:incoming>Sub_Flow_1</bpmn:incoming><bpmn:outgoing>Sub_Flow_2</bpmn:outgoing><bpmn:outgoing>Sub_Flow_3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="GP_Paths" name="Дорожки, освещение, скамейки с урнами"><bpmn:incoming>Sub_Flow_2</bpmn:incoming><bpmn:outgoing>Sub_Flow_4</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="GP_ImprJoin" name=""><bpmn:incoming>Sub_Flow_3</bpmn:incoming><bpmn:incoming>Sub_Flow_4</bpmn:incoming><bpmn:outgoing>Sub_Flow_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="GP_Features" name="Признаки участка: площадь, пригодная доля, состав зон, тип территории"><bpmn:incoming>Sub_Flow_5</bpmn:incoming><bpmn:outgoing>Sub_Flow_6</bpmn:outgoing></bpmn:task><bpmn:task id="GP_Retrieval" name="Поиск аналогов: k ближайших по косинусному сходству"><bpmn:incoming>Sub_Flow_6</bpmn:incoming><bpmn:outgoing>Sub_Flow_7</bpmn:outgoing><bpmn:property id="GP_Retrieval_In0" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="Sub_Assoc_0"><bpmn:sourceRef>GP_Corpus</bpmn:sourceRef><bpmn:targetRef>GP_Retrieval_In0</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:task><bpmn:dataStoreReference id="GP_Corpus" name="Корпус: 14 реальных + 20 эталонов"/><bpmn:task id="GP_Zones" name="Разбиение на зоны: у зданий, вдоль дорожек, по краю, открытые"><bpmn:incoming>Sub_Flow_7</bpmn:incoming><bpmn:outgoing>Sub_Flow_8</bpmn:outgoing></bpmn:task><bpmn:task id="GP_Assign" name="Стиль участка и приёмы зон: взвешенное голосование аналогов"><bpmn:incoming>Sub_Flow_8</bpmn:incoming><bpmn:outgoing>Sub_Flow_9</bpmn:outgoing></bpmn:task><bpmn:task id="GP_Species" name="Подбор видов: ассортимент Москвы, 515-ПП, без 369-ПП"><bpmn:incoming>Sub_Flow_9</bpmn:incoming><bpmn:outgoing>Sub_Flow_10</bpmn:outgoing><bpmn:property id="GP_Species_In1" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="Sub_Assoc_1"><bpmn:sourceRef>GP_Assortment</bpmn:sourceRef><bpmn:targetRef>GP_Species_In1</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:task><bpmn:dataStoreReference id="GP_Assortment" name="Ассортимент Москвы, 369-ПП, 515-ПП"/><bpmn:task id="GP_Place" name="Расстановка: ряды, заливка, группы; отступ по норме в каждой точке"><bpmn:incoming>Sub_Flow_10</bpmn:incoming><bpmn:outgoing>Sub_Flow_11</bpmn:outgoing><bpmn:property id="GP_Place_In2" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="Sub_Assoc_2"><bpmn:sourceRef>GP_Norms</bpmn:sourceRef><bpmn:targetRef>GP_Place_In2</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="Sub_Assoc_3"><bpmn:targetRef>GP_Rejected</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task><bpmn:dataStoreReference id="GP_Norms" name="Отступы: СП 42, 743-ПП, МГСН 1.02-02, СП 82"/><bpmn:dataObject id="GP_Rejected_Data"/><bpmn:dataObjectReference id="GP_Rejected" name="Журнал отклонённых точек" dataObjectRef="GP_Rejected_Data"/><bpmn:task id="GP_Lawn" name="Газон на свободной от покрытий и клумб земле"><bpmn:incoming>Sub_Flow_11</bpmn:incoming><bpmn:outgoing>Sub_Flow_12</bpmn:outgoing></bpmn:task><bpmn:task id="GP_Check" name="Независимая проверка нарушений, ведомость"><bpmn:incoming>Sub_Flow_12</bpmn:incoming><bpmn:outgoing>Sub_Flow_13</bpmn:outgoing></bpmn:task><bpmn:endEvent id="GP_End" name="Сцена с посадкой, решения по зонам"><bpmn:incoming>Sub_Flow_13</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Sub_Flow_0" sourceRef="GP_Start" targetRef="GP_Clean"/><bpmn:sequenceFlow id="Sub_Flow_1" sourceRef="GP_Clean" targetRef="GP_Impr"/><bpmn:sequenceFlow id="Sub_Flow_2" name="да" sourceRef="GP_Impr" targetRef="GP_Paths"/><bpmn:sequenceFlow id="Sub_Flow_3" name="нет" sourceRef="GP_Impr" targetRef="GP_ImprJoin"/><bpmn:sequenceFlow id="Sub_Flow_4" sourceRef="GP_Paths" targetRef="GP_ImprJoin"/><bpmn:sequenceFlow id="Sub_Flow_5" sourceRef="GP_ImprJoin" targetRef="GP_Features"/><bpmn:sequenceFlow id="Sub_Flow_6" sourceRef="GP_Features" targetRef="GP_Retrieval"/><bpmn:sequenceFlow id="Sub_Flow_7" sourceRef="GP_Retrieval" targetRef="GP_Zones"/><bpmn:sequenceFlow id="Sub_Flow_8" sourceRef="GP_Zones" targetRef="GP_Assign"/><bpmn:sequenceFlow id="Sub_Flow_9" sourceRef="GP_Assign" targetRef="GP_Species"/><bpmn:sequenceFlow id="Sub_Flow_10" sourceRef="GP_Species" targetRef="GP_Place"/><bpmn:sequenceFlow id="Sub_Flow_11" sourceRef="GP_Place" targetRef="GP_Lawn"/><bpmn:sequenceFlow id="Sub_Flow_12" sourceRef="GP_Lawn" targetRef="GP_Check"/><bpmn:sequenceFlow id="Sub_Flow_13" sourceRef="GP_Check" targetRef="GP_End"/></bpmn:subProcess>
<bpmn:dataStoreReference id="Corpus" name="Корпус 34 проектов, нормы НПА, ассортимент"/>
<bpmn:task id="Check" name="Проверка результата, ручные правки на сцене"><bpmn:incoming>Main_Flow_9</bpmn:incoming><bpmn:outgoing>Main_Flow_10</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="TextEdit" name="Правка текстом?"><bpmn:incoming>Main_Flow_10</bpmn:incoming><bpmn:outgoing>Main_Flow_11</bpmn:outgoing><bpmn:outgoing>Main_Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Assistant" name="ИИ-ассистент: список операций правки (Qwen3 235B)"><bpmn:incoming>Main_Flow_11</bpmn:incoming><bpmn:outgoing>Main_Flow_13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:task id="Apply" name="Применение операций планировщиком с проверкой норм"><bpmn:incoming>Main_Flow_13</bpmn:incoming><bpmn:outgoing>Main_Flow_14</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="EditJoin" name=""><bpmn:incoming>Main_Flow_12</bpmn:incoming><bpmn:incoming>Main_Flow_14</bpmn:incoming><bpmn:outgoing>Main_Flow_15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:parallelGateway id="Fork" name=""><bpmn:incoming>Main_Flow_15</bpmn:incoming><bpmn:outgoing>Main_Flow_16</bpmn:outgoing><bpmn:outgoing>Main_Flow_17</bpmn:outgoing><bpmn:outgoing>Main_Flow_18</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:task id="Export" name="Экспорт DXF поверх исходника: слои NEW_*, USER_*, XDATA с id"><bpmn:incoming>Main_Flow_16</bpmn:incoming><bpmn:outgoing>Main_Flow_20</bpmn:outgoing></bpmn:task>
<bpmn:task id="Explain" name="Объяснения посадок со ссылками на НПА (JSON, CSV)"><bpmn:incoming>Main_Flow_17</bpmn:incoming><bpmn:outgoing>Main_Flow_21</bpmn:outgoing></bpmn:task>
<bpmn:serviceTask id="Report" name="Текст-обоснование решений (YandexGPT 5.1 Pro)"><bpmn:incoming>Main_Flow_18</bpmn:incoming><bpmn:outgoing>Main_Flow_19</bpmn:outgoing></bpmn:serviceTask>
<bpmn:task id="Note" name="Пояснительная записка (DOCX)"><bpmn:incoming>Main_Flow_19</bpmn:incoming><bpmn:outgoing>Main_Flow_22</bpmn:outgoing></bpmn:task>
<bpmn:parallelGateway id="Join" name=""><bpmn:incoming>Main_Flow_20</bpmn:incoming><bpmn:incoming>Main_Flow_21</bpmn:incoming><bpmn:incoming>Main_Flow_22</bpmn:incoming><bpmn:outgoing>Main_Flow_23</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:endEvent id="End" name="Выходной DXF, файл объяснений, записка"><bpmn:incoming>Main_Flow_23</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Main_Flow_0" sourceRef="Start" targetRef="Upload"/>
<bpmn:sequenceFlow id="Main_Flow_1" sourceRef="Upload" targetRef="Format"/>
<bpmn:sequenceFlow id="Main_Flow_2" name="DWG" sourceRef="Format" targetRef="Dwg"/>
<bpmn:sequenceFlow id="Main_Flow_3" name="DXF" sourceRef="Format" targetRef="FormatJoin"/>
<bpmn:sequenceFlow id="Main_Flow_4" sourceRef="Dwg" targetRef="FormatJoin"/>
<bpmn:sequenceFlow id="Main_Flow_5" sourceRef="FormatJoin" targetRef="Store"/>
<bpmn:sequenceFlow id="Main_Flow_6" sourceRef="Store" targetRef="Parse"/>
<bpmn:sequenceFlow id="Main_Flow_7" sourceRef="Parse" targetRef="Review"/>
<bpmn:sequenceFlow id="Main_Flow_8" sourceRef="Review" targetRef="GreenPlan"/>
<bpmn:sequenceFlow id="Main_Flow_9" sourceRef="GreenPlan" targetRef="Check"/>
<bpmn:sequenceFlow id="Main_Flow_10" sourceRef="Check" targetRef="TextEdit"/>
<bpmn:sequenceFlow id="Main_Flow_11" name="да" sourceRef="TextEdit" targetRef="Assistant"/>
<bpmn:sequenceFlow id="Main_Flow_12" name="нет" sourceRef="TextEdit" targetRef="EditJoin"/>
<bpmn:sequenceFlow id="Main_Flow_13" sourceRef="Assistant" targetRef="Apply"/>
<bpmn:sequenceFlow id="Main_Flow_14" sourceRef="Apply" targetRef="EditJoin"/>
<bpmn:sequenceFlow id="Main_Flow_15" sourceRef="EditJoin" targetRef="Fork"/>
<bpmn:sequenceFlow id="Main_Flow_16" sourceRef="Fork" targetRef="Export"/>
<bpmn:sequenceFlow id="Main_Flow_17" sourceRef="Fork" targetRef="Explain"/>
<bpmn:sequenceFlow id="Main_Flow_18" sourceRef="Fork" targetRef="Report"/>
<bpmn:sequenceFlow id="Main_Flow_19" sourceRef="Report" targetRef="Note"/>
<bpmn:sequenceFlow id="Main_Flow_20" sourceRef="Export" targetRef="Join"/>
<bpmn:sequenceFlow id="Main_Flow_21" sourceRef="Explain" targetRef="Join"/>
<bpmn:sequenceFlow id="Main_Flow_22" sourceRef="Note" targetRef="Join"/>
<bpmn:sequenceFlow id="Main_Flow_23" sourceRef="Join" targetRef="End"/>
</bpmn:process>
